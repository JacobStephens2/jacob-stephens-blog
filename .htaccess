RewriteEngine on

# Working notes are kept in the repo but never served.
RedirectMatch 404 ^/\.notes(/.*)?$
RedirectMatch 404 ^/posts\.json$
RedirectMatch 404 ^/tools(/.*)?$
# The domain model: CONTEXT-MAP.md at the root and a CONTEXT.md beside any post
# that has one. These name draft slugs, so they must not be served or crawled.
# Deliberately narrow: model-council/research.md is linked from published posts
# as "Raw markdown" and must keep serving.
RedirectMatch 404 ^/(.*/)?CONTEXT(-MAP)?\.md$
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Redirect poker subpaths
RewriteCond %{HTTP_HOST} ^blog\.stephens\.page$ [OR]
RewriteCond %{HTTP_HOST} ^jacobstephens\.net$ [OR]
RewriteCond %{HTTP_HOST} ^www\.jacobstephens\.net$
RewriteRule ^poker\-tournament\/?(.*)$ "https\:\/\/poker\.stewardgoods\.com\/tournament$1" [R=301,L]
RewriteCond %{HTTP_HOST} ^blog\.stephens\.page$ [OR]
RewriteCond %{HTTP_HOST} ^jacobstephens\.net$ [OR]
RewriteCond %{HTTP_HOST} ^www\.jacobstephens\.net$
RewriteRule ^poker\-discord\/?(.*)$ "https\:\/\/discord\.gg\/bxFEdktvcp$1" [R=301,L]

# Redirect underscore post URLs to hyphenated equivalents
RewriteRule ^posts/bending_fire(/.*)?$ /posts/bending-fire$1 [R=301,L]

# Redirect removed post to posts index
RewriteRule ^posts/progressive-web-app-for-dana-alans-campaign/?$ /posts/ [R=301,L]
RewriteRule ^posts/the-well-played-game-web-app/?$ /posts/ [R=301,L]
RewriteRule ^posts/custom-wordpress-theme-live-on-demo-website/?$ /posts/ [R=301,L]
